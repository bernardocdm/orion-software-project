@startuml
left to right direction
skinparam packageStyle rectangle

actor Cliente
actor Atendente
actor "Mecânico" as Mecanico
actor Administrador

rectangle "Orion AutoWorks" {

  usecase "Cadastrar Cliente" as UC1
  usecase "Cadastrar Veículo" as UC2
  usecase "Criar Ordem de Serviço" as UC3
  usecase "Gerar Orçamento" as UC4

  usecase "Aprovar Orçamento" as UC5
  usecase "Consultar Status da OS" as UC6
  usecase "Consultar Histórico\n de Manutenção" as UC7

  usecase "Atualizar Status da OS" as UC8
  usecase "Registrar Peças\nUtilizadas" as UC9
  usecase "Finalizar Serviço" as UC10

  usecase "Gerenciar Estoque" as UC11
  usecase "Gerenciar Usuários" as UC12
  usecase "Emitir Relatórios" as UC13
}

Cliente --> UC5
Cliente --> UC6
Cliente --> UC7

Atendente --> UC1
Atendente --> UC2
Atendente --> UC3
Atendente --> UC4

Mecanico --> UC8
Mecanico --> UC9
Mecanico --> UC10

Administrador --> UC11
Administrador --> UC12
Administrador --> UC13

UC3 .> UC1 : <<include>>
UC3 .> UC2 : <<include>>
UC4 .> UC3 : <<include>>
UC10 .> UC8 : <<include>>

@enduml