@startuml implant
title Diagrama de Implantação - Orion AutoWorks

skinparam componentStyle rectangle
top to bottom direction

node "Estação do Usuário" <<device>> as Client {
    artifact "Navegador Web\n(Chrome, Edge, Firefox)" as Browser
}

node "Servidor de Aplicação" <<server>> as AppServer {

    artifact "Orion AutoWorks\nAplicação Web" as WebApp

    component "Módulo de\nUsuários" as Usuario
    component "Módulo de\nClientes e Veículos" as ClienteVeiculo
    component "Módulo de\nOrdens de Serviço" as OS
    component "Módulo de\nEstoque" as Estoque
    component "Módulo de\nRelatórios" as Relatorios

    WebApp --> Usuario
    WebApp --> ClienteVeiculo
    WebApp --> OS
    WebApp --> Estoque
    WebApp --> Relatorios
}

database "Servidor de Banco de Dados\nOrionDB" <<database>> as DB

node "Servidor de Backup" <<server>> as Backup {
    artifact "Rotina de Backup\nDiário"
}

cloud "Serviço de E-mail\n(Notificações)" as Email

Browser --> WebApp : HTTPS
Usuario --> DB : SQL
ClienteVeiculo --> DB : SQL
OS --> DB : SQL
Estoque --> DB : SQL
Relatorios --> DB : SQL

OS --> Email : Envia notificação\nde orçamento/status

DB --> Backup : Backup periódico

@enduml